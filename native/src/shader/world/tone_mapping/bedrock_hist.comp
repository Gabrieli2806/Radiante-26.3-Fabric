#version 460
// Luminance histogram for the Bedrock-style tone curve (bedrock_curve.comp). Independent approximation of its
// observed behaviour: 256 bins over log2 luminance -24 .. +4,
// each pixel shared between the two nearest bins in 1/64 steps.
#define NUM_BINS 256
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
const float LOG2_MIN = -24.0;
const float LOG2_RANGE = 28.0;
const float WEIGHT_STEPS = 64.0;

layout(set = 0, binding = 0) uniform sampler2D uHdr;

layout(set = 0, binding = 2) readonly buffer ExposureBuffer {
    float exposure;
    float avgLogLum;
    float padding0;
    float padding1;
}
expData;

layout(std430, set = 0, binding = 4) buffer BedrockCurveBuffer {
    uint histogram[NUM_BINS];
    float curve[NUM_BINS];
}
bedrock;

layout(push_constant) uniform PushConstant {
    float dynamicRange;
    float curveShift;
    float maxExposureIncrease;
    float shadowMinSlope;
    float shadowContrast;
    float shadowContrastEnd;
    int needsReset;
    int autoExposure;
    float manualExposure;
    float exposureBias;
}
pc;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

shared uint sHist[NUM_BINS];

void main() {
    uint lid = gl_LocalInvocationIndex;
    sHist[lid] = 0u;
    barrier();

    ivec2 size = textureSize(uHdr, 0);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(p, size))) {
        float exposure = pc.autoExposure != 0 ? expData.exposure : pc.manualExposure;
        if (isnan(exposure) || isinf(exposure) || exposure <= 0.0) { exposure = max(pc.manualExposure, 1e-6); }
        exposure *= exp2(pc.exposureBias);

        float lum = dot(texelFetch(uHdr, p, 0).rgb, LUMA) * exposure;
        // Black and over-range pixels are left out of the histogram altogether.
        if (lum > 0.0 && lum < exp2(LOG2_MIN + LOG2_RANGE)) {
            float position = (max(log2(lum), LOG2_MIN) - LOG2_MIN) * (float(NUM_BINS - 1) / LOG2_RANGE);
            uint lower = uint(position);
            float upperShare = fract(position);
            atomicAdd(sHist[lower], uint((1.0 - upperShare) * WEIGHT_STEPS));
            if (lower + 1u < NUM_BINS) { atomicAdd(sHist[lower + 1u], uint(upperShare * WEIGHT_STEPS)); }
        }
    }
    barrier();

    uint v = sHist[lid];
    if (v != 0u) { atomicAdd(bedrock.histogram[lid], v); }
}
