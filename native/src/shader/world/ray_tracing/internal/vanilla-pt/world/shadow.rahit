#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "util/alpha_mode.glsl"
#include "common/fft_water.glsl"
#include "common/bedrock_caustics.glsl"


#ifndef VPT_WATER_LIGHT_DEPTH
#    define VPT_WATER_LIGHT_DEPTH 3.0
#endif
const float WATER_LIGHT_MAX_DEPTH = VPT_WATER_LIGHT_DEPTH;
#include "util/labpbr.glsl"
#include "util/random.glsl"
#include "util/ray.glsl"
#include "util/ray_cone.glsl"
#include "util/util.glsl"
#include "common/shared.hpp"

layout(set = 0, binding = 0) uniform sampler2D textures[];

layout(set = 1, binding = 1) readonly buffer BLASOffsets {
    uint offsets[];
}
blasOffsets;

layout(set = 1, binding = 2) readonly buffer IndexBufferAddr {
    uint64_t addrs[];
}
indexBufferAddrs;

layout(set = 1, binding = 7) readonly buffer TextureMappingBuffer {
    TextureMapping mapping;
};

layout(set = 2, binding = 0) uniform Uniform {
    WorldUBO ubo;
};

layout(set = 2, binding = 2) uniform SkyUniform {
    SkyUBO skyUBO;
};

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer IndexBuffer {
    uint indices[];
}
indexBuffer;

#include "util/vertex.glsl"
#include "common/lod_coverage.glsl"
#include "common/seamless_glass.glsl"

#ifndef VPT_FOLIAGE_CULLING
#    define VPT_FOLIAGE_CULLING 0
#endif
#ifndef VPT_FOLIAGE_DISTANCE
#    define VPT_FOLIAGE_DISTANCE 48.0
#endif

// Foliage culling, as Bedrock RTX does: small plants past a distance from the camera are left out, appearing a few
// triangles at a time over the last 8 blocks as the camera comes closer. Positions are camera-relative.
bool foliageCulled(uint packedData) {
#if VPT_FOLIAGE_CULLING != 0
    if (!isPlantSurface(packedData)) { return false; }
    vec3 hit = gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT;
    const float fade = 8.0;
    float start = VPT_FOLIAGE_DISTANCE - fade;
    float d = length(hit.xz);
    if (d < start) { return false; }
    uint h = (uint(gl_PrimitiveID) >> 2u) * 747796405u + gl_InstanceCustomIndexEXT * 2891336453u +
             uint(gl_GeometryIndexEXT) * 277803737u;
    h ^= h >> 16u;
    h *= 2246822519u;
    h ^= h >> 13u;
    return (d - start) / fade > float(h & 0xFFFFu) / 65535.0;
#else
    return false;
#endif
}

layout(location = 1) rayPayloadInEXT ShadowRay shadowRay;
hitAttributeEXT vec2 attribs;

#ifndef VPT_SHADOW_TINT_MODEL
#    define VPT_SHADOW_TINT_MODEL 0
#endif

void main() {
    if (VPT_LOD_COVERED(ubo)) {
        ignoreIntersectionEXT;
        return;
    }
    uint instanceID = gl_InstanceCustomIndexEXT;
    uint geometryID = gl_GeometryIndexEXT;
    uint geometryBufferIndex = getGeometryBufferIndex(instanceID, geometryID);

    uint i0, i1, i2;
    PositionVertex p0, p1, p2;
    MaterialVertex m0, m1, m2;
    loadTriangle(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2, p0, p1, p2, m0, m1, m2);
    vec3 baryCoords = vec3(1.0 - (attribs.x + attribs.y), attribs.x, attribs.y);
    uint packedData = m0.packedData;
    uint textureID = m0.textureID;
    uint alphaMode = getAlphaMode(packedData);
    if (foliageCulled(packedData)) {
        ignoreIntersectionEXT;
        return;
    }

    vec4 colorLayer =
        hasColorLayer(packedData) ?
            (baryCoords.x * m0.colorLayer + baryCoords.y * m1.colorLayer + baryCoords.z * m2.colorLayer) :
            vec4(1.0);

    vec4 albedo = vec4(1.0);
    vec2 textureUV = vec2(0.0);

    if (hasTexture(packedData)) {
        textureUV = baryCoords.x * m0.textureUV + baryCoords.y * m1.textureUV + baryCoords.z * m2.textureUV;
        if (isGlassSurface(packedData)) {
            if (seamlessGlassHidesFace(p0.pos, p1.pos, p2.pos)) {
                ignoreIntersectionEXT;
                return;
            }
            vec3 glassDposdu, glassDposdv;
            computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, glassDposdu, glassDposdv);
            textureUV = seamlessGlassUV(textureUV, baryCoords.x * p0.pos + baryCoords.y * p1.pos + baryCoords.z * p2.pos,
                                        glassDposdu, glassDposdv);
        }
        albedo = sampleTexture(textures[nonuniformEXT(textureID)], textureUV, false);
    }
    ivec4 flags = ivec4(0);
    bool isWaterMaterial = isWaterSurface(packedData);
    if (hasTexture(packedData)) {
        int flagTextureID = mapping.entries[textureID].flag;
        if (flagTextureID >= 0) {
            flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTextureID)], textureUV, 0.0, false) * 255.0));
            isWaterMaterial = isWaterMaterial || (flags.r & 0x1) > 0;
        }
    }
    vec4 shadedAlbedo = albedo * colorLayer;
    if (alphaMode == ALPHA_MODE_ADDITIVE) {
        ignoreIntersectionEXT;
        return;
    }
    // Stochastic surfaces (ice) block light with the same probability camera rays see them, so on average the
    // shadow lets through what the surface does.
    if (alphaMode == ALPHA_MODE_STOCHASTIC && shadedAlbedo.a >= 0.05 && shadedAlbedo.a < 0.999) {
        uint stochasticSeed = xxhash32(uvec3(gl_LaunchIDEXT.xy, ubo.seed ^ uint(gl_PrimitiveID) ^ 0x5bd1e995u));
        if (rand(stochasticSeed) >= shadedAlbedo.a) {
            ignoreIntersectionEXT;
            return;
        }
    }
    float alpha = resolveSurfaceAlpha(shadedAlbedo.a, alphaMode);
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }

    if (shadowRay.pad0 == GLOW_OUTLINE_QUERY) {
        shadowRay.radiance = colorLayer.rgb;
        shadowRay.throughput = vec3(-1.0);
        terminateRayEXT;
        return;
    }

    if (shadowRay.insideBoat > 0u && hasTexture(packedData)) {
        if (isWaterMaterial) {
            ignoreIntersectionEXT;
            return;
        }
    }

    if (!isWaterMaterial && alphaMode != ALPHA_MODE_TRANSPARENT) {
        terminateRayEXT;
        return;
    }

    vec4 specular = vec4(0.0);
    if (hasTexture(packedData)) {
        int specularTextureID = mapping.entries[textureID].specular;
        if (specularTextureID >= 0) {
            specular = sampleTexture(textures[nonuniformEXT(specularTextureID)], textureUV, false);
        }
    }

    vec2 glintUV = baryCoords.x * m0.glintUV + baryCoords.y * m1.glintUV + baryCoords.z * m2.glintUV;
    glintUV = (ubo.textureMat * vec4(glintUV, 0.0, 1.0)).xy;
    vec3 glint = hasGlint(packedData) ? sampleTexture(textures[nonuniformEXT(m0.glintTexture)], glintUV, false).rgb :
                                          vec3(0.0);
    glint *= glint;

    vec3 tint = shadedAlbedo.rgb;
    if (hasOverlay(packedData)) {
        vec4 overlayColor = sampleTexture(textures[nonuniformEXT(ubo.overlayTextureID)], m0.overlayUV, 0, false);
        tint = mix(overlayColor.rgb, tint, overlayColor.a) + glint;
    } else {
        tint += glint;
    }
    shadedAlbedo.a = alpha;

    LabPBRMat mat = convertLabPBRMaterial(shadedAlbedo, specular, vec4(0.0));

    if (isWaterMaterial || mat.transmission > 0.0 || alpha < 0.95) {
        // Light that gets through coloured glass takes the glass's colour: a see-through block filters by its hue at
        // full brightness (glassTint), whatever its texture's darkness; anything else keeps vanilla's alpha blend.
        vec3 shadowTransmission =
            isWaterMaterial ? vec3(1.0) :
            mat.transmission > 0.0 ? clamp(glassTint(tint, alpha), vec3(0.0), vec3(1.0)) :
                                     clamp(mix(vec3(1.0), tint, alpha), vec3(0.0), vec3(1.0));
#if VPT_SHADOW_TINT_MODEL != 0
        // Bedrock compatibility - observed behaviour. Sunlight through a
        // see-through surface is filtered by the colour of its texture as it is, not by its hue brought to full
        // brightness, and by how little of the surface is opaque: the texture's alpha is first remapped so that
        // the lower half of the range counts as clear, T = colour * (1 - saturate(2 alpha - 1)). The light is shadow
        // once what is left carries almost nothing (the sum of its channels is at or under 0.01).
        if (!isWaterMaterial) {
            shadowTransmission = clamp(viewGlassTintBedrock(tint, alpha), vec3(0.0), vec3(1.0));
        }
#endif
        // Sunlight reaching the bottom through the top of the water: absorbed on the way down, and gathered into
        // the moving caustic pattern the waves focus it into.
        if (isWaterMaterial) {
            vec3 dposdu;
            vec3 dposdv;
            mat3 objectToWorld = mat3(gl_ObjectToWorld3x4EXT);
            computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
            vec3 dPduWorld = objectToWorld * dposdu;
            vec3 dPdvWorld = objectToWorld * dposdv;
            vec3 worldNormal =
                normalize(cross(dPduWorld, dPdvWorld));
            if (abs(worldNormal.y) > 0.75) {
                vec3 hitWorldPos = gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT;
                vec3 absWorldPos = hitWorldPos + vec3(ubo.cameraPos.xyz);
                vec3 waterCoordNormal = worldNormal.y >= 0.0 ? worldNormal : -worldNormal;
                vec2 waterCoord = fftWaterSurfaceCoord(absWorldPos, dPduWorld, dPdvWorld, waterCoordNormal);
                float waterDepth = gl_HitTEXT * max(dot(normalize(gl_WorldRayDirectionEXT), waterCoordNormal), 0.01);
                // Sunlight keeps reaching the bottom of deep water, tinted, as in Bedrock RTX: past a few blocks
                // the full depth took it all, and a sunken hall lit only by its lanterns.
                float absorbDepth = min(waterDepth, WATER_LIGHT_MAX_DEPTH);
                // A Bedrock pack's water absorbs by its own coefficients; otherwise by the biome's water colour,
                // the way the vanilla tint reads.
                vec3 absorption = skyUBO.waterExtinction.w > 0.5 ?
                                      exp(-max(skyUBO.waterExtinction.rgb, vec3(0.0)) * absorbDepth) :
                                      exp(-(vec3(1.0) - clamp(colorLayer.rgb, vec3(0.0), vec3(1.0))) * waterDepth * 0.22);
                float caustic = bedrockCausticsAvailable() ?
                                    sampleBedrockCaustic(absWorldPos.xz, ubo.gameTime, waterDepth) :
                                    sampleFftWaterCaustic(waterCoord, ubo.gameTime, gl_WorldRayDirectionEXT, waterDepth);
                shadowTransmission = absorption * caustic;
            }
        }
        shadowRay.throughput *= shadowTransmission;
#if VPT_SHADOW_TINT_MODEL != 0
        if (dot(shadowRay.throughput, vec3(1.0)) <= 0.01) {
            shadowRay.throughput = vec3(0.0);
            terminateRayEXT;
            return;
        }
#endif
        ignoreIntersectionEXT;
    } else {
        terminateRayEXT;
    }
}
