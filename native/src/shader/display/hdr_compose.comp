#version 460

// HDR display output (core/render/hdr_output.cpp): Minecraft's final image, composed for a 16-bit float scRGB
// swapchain. 1.0 in scRGB is 80 nits, linear, sRGB primaries.
//
// Where the pixel is still the traced world exactly as it was fused into Minecraft's image, it is rebuilt from the
// world's HDR radiance: same exposure and same tone curve as the SDR image below the paper white, so the picture
// matches, but highlights keep rising up to the display's peak instead of being squeezed under 1.0. Everything
// else - menus, text, the hotbar, anything drawn over the world, or the whole screen when no world was traced - is
// Minecraft's SDR image at the paper white brightness.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D minecraftImage; // final, UI included; gamma 2.2
layout(set = 0, binding = 1) uniform sampler2D worldFinal;     // the world as fused into minecraftImage
layout(set = 0, binding = 2) uniform sampler2D worldMapped;    // tone mapped, before the post render passes
layout(set = 0, binding = 3) uniform sampler2D worldRadiance;  // what the tone mapping read

layout(set = 0, binding = 4) readonly buffer ExposureBuffer {
    float exposure;
    float avgLogLum;
    float padding0;
    float padding1;
}
expData;

layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D composed;

layout(push_constant) uniform PushConstant {
    float paperWhite; // scRGB value of SDR white
    float peak;       // the display's peak brightness, in paper whites (>= 1)
    float exposureBias;
    float saturation;
    float manualExposure;
    int autoExposure;
    int worldValid;
    int padding;
}
pc;

// Half a step of an 8-bit channel: two values closer than this are the same stored value.
const float SAME = 0.5 / 255.0;

bool same(vec3 a, vec3 b) {
    return all(lessThan(abs(a - b), vec3(SAME)));
}

vec3 sdrToScRgb(vec3 encoded) {
    return pow(max(encoded, vec3(0.0)), vec3(2.2)) * pc.paperWhite;
}

// Khronos PBR Neutral (the SDR tone mapping's default), with the shoulder ending at `peak` instead of 1. Below
// the start of the shoulder it is the SDR curve exactly, so shadows and midtones look the same as in SDR.
vec3 pbrNeutralToPeak(vec3 color, float peak) {
    const float startCompression = 0.76;
    const float desaturation = 0.01;

    float x = min(color.r, min(color.g, color.b));
    float offset = (x < 0.08) ? (x - 6.25 * x * x) : 0.04;
    color -= offset;

    float top = max(color.r, max(color.g, color.b));
    if (top < startCompression) return color;

    float d = peak - startCompression;
    float newTop = peak - d * d / (top + d - startCompression);
    color *= newTop / top;

    float g = 1.0 - 1.0 / (desaturation * (top - newTop) + 1.0);
    return mix(color, newTop * vec3(1.0), g);
}

vec3 applySaturation(vec3 color, float saturation) {
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    return mix(vec3(luma), color, saturation);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(composed);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 minecraft = texelFetch(minecraftImage, pixel, 0).rgb;
    vec3 result = sdrToScRgb(minecraft);

    if (pc.worldValid != 0) {
        vec3 worldPixel = texelFetch(worldFinal, pixel, 0).rgb;
        // Untouched since the world was fused in, and not a star, text or other post pass drawn over it.
        if (same(minecraft, worldPixel) && same(worldPixel, texelFetch(worldMapped, pixel, 0).rgb)) {
            float exposure = pc.autoExposure != 0 ? expData.exposure : pc.manualExposure;
            if (isnan(exposure) || isinf(exposure) || exposure <= 0.0) exposure = max(pc.manualExposure, 1e-6);
            exposure *= exp2(pc.exposureBias);

            vec3 radiance = max(texelFetch(worldRadiance, pixel, 0).rgb * exposure, vec3(0.0));
            vec3 mapped = max(pbrNeutralToPeak(radiance, max(pc.peak, 1.0)), vec3(0.0));
            mapped = max(applySaturation(mapped, max(pc.saturation, 0.0)), vec3(0.0));
            if (!any(isnan(mapped)) && !any(isinf(mapped))) result = mapped * pc.paperWhite;
        }
    }

    imageStore(composed, pixel, vec4(result, 1.0));
}
